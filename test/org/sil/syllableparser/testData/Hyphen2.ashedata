    <otApproach>
        <rankings>
            <ranking ranking="8634013f-2c6c-477c-b928-1ca9b922feb8 886ca941-5cb8-4b4e-a07b-c7721059d9ca 5274463f-e44c-4474-a306-312fd5c8fd91 fe57515a-d4a3-427c-a739-b7ebb720108a 07751bf8-d3fd-4cce-9fc4-d64dd57a960c 50863688-ec78-4f93-9ba0-1f5f236e35bb 5c1397cb-13d3-4430-9785-06c273aa17a7 377e55fb-ab7f-4f45-803c-137af536c0f9" id="78bf322e-1efa-4f42-a6b5-bcdee3de20a6" active="true">
                <description>Sample ranking that should be edited.</description>
                <name>Default ranking</name>
                <rankingRepresentation>*Peak/C &lt; *Margin/V &lt; Parse &lt; *Complex/Onset &lt; *Complex/Coda &lt; NoCoda &lt; Onset1 &lt; Onset2</rankingRepresentation>
            </ranking>
        </rankings>
        <constraints>
            <constraint pruneElement2="false" structuralOptions1="2" structuralOptions2="0" valid="true" id="8634013f-2c6c-477c-b928-1ca9b922feb8" active="true">
                <affectedElement1>[C]</affectedElement1>
                <affectedElement2></affectedElement2>
                <affectedSegOrNC1 isSegment="false" segOrNC="b500749a-9617-444c-ae28-7552cb3236ec" active="true"/>
                <constraintName>*Peak/C</constraintName>
                <description>Syllable peaks are not consonants</description>
                <lingTreeDescription>(\O(\O[C](n)))</lingTreeDescription>
            </constraint>
            <constraint pruneElement2="false" structuralOptions1="5" structuralOptions2="0" valid="true" id="886ca941-5cb8-4b4e-a07b-c7721059d9ca" active="true">
                <affectedElement1>[V]</affectedElement1>
                <affectedElement2></affectedElement2>
                <affectedSegOrNC1 isSegment="false" segOrNC="9821d4ba-8c34-432d-9afe-7c428dcd9afa" active="true"/>
                <constraintName>*Margin/V</constraintName>
                <description>Vowels are neither onsets nor codas</description>
                <lingTreeDescription>(\O(\O[V]({o, c})))</lingTreeDescription>
            </constraint>
            <constraint pruneElement2="false" structuralOptions1="8" structuralOptions2="0" valid="true" id="5274463f-e44c-4474-a306-312fd5c8fd91" active="true">
                <affectedElement1>&lt;Any&gt;</affectedElement1>
                <affectedElement2></affectedElement2>
                <constraintName>Parse</constraintName>
                <description>Every segment should be parsed</description>
                <lingTreeDescription>(\O(\O&lt;Any&gt;(u)))</lingTreeDescription>
            </constraint>
            <constraint pruneElement2="false" structuralOptions1="4" structuralOptions2="0" valid="true" id="50863688-ec78-4f93-9ba0-1f5f236e35bb" active="true">
                <affectedElement1>&lt;Any&gt;</affectedElement1>
                <affectedElement2></affectedElement2>
                <constraintName>NoCoda</constraintName>
                <description>Codas not allowed</description>
                <lingTreeDescription>(\O(\O&lt;Any&gt;(c)))</lingTreeDescription>
            </constraint>
            <constraint pruneElement2="true" structuralOptions1="4" structuralOptions2="4" valid="true" id="07751bf8-d3fd-4cce-9fc4-d64dd57a960c" active="true">
                <affectedElement1>[C]</affectedElement1>
                <affectedElement2>[C]</affectedElement2>
                <affectedSegOrNC1 isSegment="false" segOrNC="b500749a-9617-444c-ae28-7552cb3236ec" active="true"/>
                <affectedSegOrNC2 isSegment="false" segOrNC="b500749a-9617-444c-ae28-7552cb3236ec" active="true"/>
                <constraintName>*Complex/Coda</constraintName>
                <description>Avoid complex codas</description>
                <lingTreeDescription>(\O(\O[C](c))(\O[C](c)))</lingTreeDescription>
            </constraint>
            <constraint pruneElement2="false" structuralOptions1="1" structuralOptions2="1" valid="true" id="fe57515a-d4a3-427c-a739-b7ebb720108a" active="true">
                <affectedElement1>[C]</affectedElement1>
                <affectedElement2>[C]</affectedElement2>
                <affectedSegOrNC1 isSegment="false" segOrNC="b500749a-9617-444c-ae28-7552cb3236ec" active="true"/>
                <affectedSegOrNC2 isSegment="false" segOrNC="b500749a-9617-444c-ae28-7552cb3236ec" active="true"/>
                <constraintName>*Complex/Onset</constraintName>
                <description>Avoid complex onsets</description>
                <lingTreeDescription>(\O(\O[C](o))(\O[C](o)))</lingTreeDescription>
            </constraint>
            <constraint pruneElement2="false" structuralOptions1="14" structuralOptions2="2" valid="true" id="5c1397cb-13d3-4430-9785-06c273aa17a7" active="true">
                <affectedElement1>&lt;Any&gt;</affectedElement1>
                <affectedElement2>&lt;Any&gt;</affectedElement2>
                <constraintName>Onset1</constraintName>
                <description>Avoid anything other than an onset before a nucleus</description>
                <lingTreeDescription>(\O(\O&lt;Any&gt;({n, c, u}))(\O&lt;Any&gt;(n)))</lingTreeDescription>
            </constraint>
            <constraint pruneElement2="false" structuralOptions1="18" structuralOptions2="0" valid="true" id="377e55fb-ab7f-4f45-803c-137af536c0f9" active="true">
                <affectedElement1>&lt;Any&gt;</affectedElement1>
                <affectedElement2></affectedElement2>
                <constraintName>Onset2</constraintName>
                <description>Avoid a nucleus word initially</description>
                <lingTreeDescription>(\O(\O# &lt;Any&gt;(n)))</lingTreeDescription>
            </constraint>
        </constraints>
    </otApproach>
